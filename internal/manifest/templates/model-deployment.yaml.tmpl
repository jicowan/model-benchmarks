apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Name }}
    app.kubernetes.io/component: model-server
    accelbench/role: model
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .Name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .Name }}
        app.kubernetes.io/component: model-server
        accelbench/role: model
    spec:
      terminationGracePeriodSeconds: 30
{{- if .ModelServiceAccount }}
      serviceAccountName: {{ .ModelServiceAccount }}
{{- end }}
      tolerations:
{{- if eq .AcceleratorType "gpu" }}
        - key: nvidia.com/gpu
          operator: Exists
          effect: NoSchedule
{{- else if eq .AcceleratorType "cpu" }}
        # PRD-67: dedicated ARM/CPU pool taint (no device-plugin taint on CPU).
        - key: accelbench.io/cpu
          operator: Exists
          effect: NoSchedule
{{- else }}
        - key: aws.amazon.com/neuron
          operator: Exists
          effect: NoSchedule
{{- end }}
        # PRD-53: tolerate our accelbench.io/dedicated taint.
        - key: accelbench.io/dedicated
          operator: Equal
          value: "true"
          effect: NoSchedule
      nodeSelector:
        node.kubernetes.io/instance-type: {{ .InstanceTypeName }}
{{- if eq .AcceleratorType "cpu" }}
        kubernetes.io/arch: arm64
{{- end }}
      containers:
{{- if .RuntimeImage }}
        - name: {{ .RuntimeContainerName }}
          image: {{ .RuntimeImage }}
          ports:
            - name: http
              containerPort: 8000
              protocol: TCP
          env:
            - name: HF_TOKEN
              value: "{{ .HfToken }}"
{{- if and (eq .AcceleratorType "gpu") (gt .TensorParallelDegree 1) }}
            - name: NCCL_DEBUG
              value: "INFO"
            - name: NCCL_P2P_LEVEL
              value: "NVL"
{{- end }}
{{- if eq .AcceleratorType "cpu" }}
            # PRD-67: vLLM CPU knobs. KVCACHE_SPACE is an ABSOLUTE GiB allocation
            # (not a fraction), budgeted by the recommender (CPUKVCacheSpaceGiB).
            # OMP_THREADS_BIND=auto binds OpenMP threads per NUMA node — this is
            # where CPU intra-node parallelism comes from (not TP ranks).
            - name: VLLM_CPU_KVCACHE_SPACE
              value: "{{ .CPUKVCacheSpaceGiB }}"
            - name: VLLM_CPU_OMP_THREADS_BIND
              value: "auto"
{{- end }}
{{- if .UseRunaiStreamer }}
            # Run:ai streamer S3 retry tuning (both real in the streamer C++
            # source, undocumented in its markdown; defaults 1000ms / disabled).
            # Abort+retry a request that stalls below the low-speed floor.
            - name: RUNAI_STREAMER_S3_REQUEST_TIMEOUT_MS
              value: "3000"
            - name: RUNAI_STREAMER_S3_LOW_SPEED_LIMIT
              value: "1048576"
{{- if .StreamerChunkBytesize }}
            # High-bandwidth instance: AWS's 4 GiB chunk. Standard instances omit
            # this and inherit the streamer's 8 MiB object-storage default.
            - name: RUNAI_STREAMER_CHUNK_BYTESIZE
              value: "{{ .StreamerChunkBytesize }}"
{{- end }}
{{- if gt .StreamerMemoryLimitGiB 0 }}
            - name: RUNAI_STREAMER_MEMORY_LIMIT
              value: "{{ gibBytes .StreamerMemoryLimitGiB }}"
{{- end }}
{{- end }}
{{- if .RuntimeCommand }}
          command: {{ toYAMLStringList .RuntimeCommand }}
{{- end }}
          args:
{{- range .RuntimeArgs }}
            - {{ . | yamlQuote }}
{{- end }}
{{- else }}
        - name: {{ if eq .Framework "sglang" }}sglang{{ else }}vllm{{ end }}
{{- if eq .Framework "sglang" }}
{{- if .SGLangImageOverride }}
          image: {{ .SGLangImageOverride }}
{{- else }}
          image: lmsysorg/sglang:{{ .FrameworkVersion }}
{{- end }}
{{- else if eq .AcceleratorType "gpu" }}
{{- if .VLLMImageOverride }}
          image: {{ .VLLMImageOverride }}
{{- else }}
          image: {{ if .PullThroughRegistry }}{{ .PullThroughRegistry }}/dockerhub/{{ end }}vllm/vllm-openai:{{ .FrameworkVersion }}
{{- end }}
{{- else }}
          image: public.ecr.aws/neuron/pytorch-inference-vllm-neuronx:0.13.0-neuronx-py312-sdk2.28.0-ubuntu24.04
{{- end }}
          ports:
            - name: http
              containerPort: 8000
              protocol: TCP
          env:
            - name: HF_TOKEN
              value: "{{ .HfToken }}"
{{- if and (eq .AcceleratorType "gpu") (gt .TensorParallelDegree 1) }}
            - name: NCCL_DEBUG
              value: "INFO"
            - name: NCCL_P2P_LEVEL
              value: "NVL"
{{- end }}
{{- if .UseRunaiStreamer }}
            # Run:ai streamer S3 retry tuning (both real in the streamer C++
            # source, undocumented in its markdown; defaults 1000ms / disabled).
            - name: RUNAI_STREAMER_S3_REQUEST_TIMEOUT_MS
              value: "3000"
            - name: RUNAI_STREAMER_S3_LOW_SPEED_LIMIT
              value: "1048576"
{{- if .StreamerChunkBytesize }}
            # High-bandwidth instance: AWS's 4 GiB chunk. Standard instances omit
            # this and inherit the streamer's 8 MiB object-storage default.
            - name: RUNAI_STREAMER_CHUNK_BYTESIZE
              value: "{{ .StreamerChunkBytesize }}"
{{- end }}
{{- if gt .StreamerMemoryLimitGiB 0 }}
            - name: RUNAI_STREAMER_MEMORY_LIMIT
              value: "{{ gibBytes .StreamerMemoryLimitGiB }}"
{{- end }}
{{- end }}
{{- if eq .Framework "sglang" }}
          command: ["python3"]
          args:
            - "-m"
            - "sglang.launch_server"
            - "--model-path"
{{- if .UseRunaiStreamer }}
            {{- /* SGLang auto-detects runai_streamer from an s3:// path
                   but we pass --load-format explicitly to match what
                   the vLLM branch does and to make the manifest export
                   self-documenting. Tuning is JSON in
                   --model-loader-extra-config (concurrency,
                   memory_limit bytes, distributed). */}}
            - "{{ .ModelS3URI }}"
            - "--load-format"
            - "runai_streamer"
            - "--model-loader-extra-config"
            - '{"concurrency":{{ if gt .StreamerConcurrency 0 }}{{ .StreamerConcurrency }}{{ else }}32{{ end }}{{ if gt .TensorParallelDegree 1 }},"distributed":true{{ end }}{{ if gt .StreamerMemoryLimitGiB 0 }},"memory_limit":{{ gibBytes .StreamerMemoryLimitGiB }}{{ end }}}'
{{- else }}
            - "{{ .ModelHfID }}"
{{- end }}
            - "--host"
            - "0.0.0.0"
            - "--port"
            - "8000"
            - "--tp-size"
            - "{{ .TensorParallelDegree }}"
            - "--trust-remote-code"
{{- if eq .Quantization "fp8" }}
            - "--quantization"
            - "fp8"
{{- else if eq .Quantization "int8" }}
            - "--quantization"
            - "w8a8_int8"
{{- else if eq .Quantization "int4" }}
            - "--quantization"
            - "awq"
{{- end }}
{{- if gt .MaxModelLen 0 }}
            - "--context-length"
            - "{{ .MaxModelLen }}"
{{- end }}
{{- if gt .MaxNumSeqs 0 }}
            - "--max-running-requests"
            - "{{ .MaxNumSeqs }}"
{{- end }}
{{- else if eq .AcceleratorType "gpu" }}
          args:
{{- if .UseRunaiStreamer }}
            - "--model"
            - "{{ .ModelS3URI }}"
            - "--load-format"
            - "runai_streamer"
            - "--model-loader-extra-config"
            {{- /* concurrency: operator value or the S3-benchmarked default (32);
                   distributed:true only for TP>1 (each rank streams its own shard). */}}
            - '{"concurrency":{{ if gt .StreamerConcurrency 0 }}{{ .StreamerConcurrency }}{{ else }}32{{ end }}{{ if gt .TensorParallelDegree 1 }},"distributed":true{{ end }}}'
{{- else }}
            - "--model"
            - "{{ .ModelHfID }}"
{{- end }}
            - "--port"
            - "8000"
            - "--tensor-parallel-size"
            - "{{ .TensorParallelDegree }}"
            - "--trust-remote-code"
{{- if not .UseRunaiStreamer }}
{{- if eq .Quantization "fp16" }}
            - "--dtype"
            - "float16"
{{- else if eq .Quantization "int8" }}
            - "--quantization"
            - "bitsandbytes"
            - "--load-format"
            - "bitsandbytes"
{{- else if eq .Quantization "int4" }}
            - "--quantization"
            - "bitsandbytes"
            - "--load-format"
            - "bitsandbytes"
{{- end }}
{{- end }}
{{- if gt .MaxModelLen 0 }}
            - "--max-model-len"
            - "{{ .MaxModelLen }}"
{{- end }}
{{- if gt .MaxNumBatchedTokens 0 }}
            - "--max-num-batched-tokens"
            - "{{ .MaxNumBatchedTokens }}"
{{- end }}
{{- if gt .MaxNumSeqs 0 }}
            - "--max-num-seqs"
            - "{{ .MaxNumSeqs }}"
{{- end }}
{{- if .KVCacheDtype }}
            - "--kv-cache-dtype"
            - "{{ .KVCacheDtype }}"
{{- end }}
{{- else }}
          command: ["vllm"]
          args:
            - "serve"
            - "{{ .ModelHfID }}"
            - "--port"
            - "8000"
            - "--tensor-parallel-size"
            - "{{ .TensorParallelDegree }}"
            - "--trust-remote-code"
            - "--block-size"
            - "32"
{{- if gt .MaxModelLen 0 }}
            - "--max-model-len"
            - "{{ .MaxModelLen }}"
{{- end }}
{{- if gt .MaxNumBatchedTokens 0 }}
            - "--max-num-batched-tokens"
            - "{{ .MaxNumBatchedTokens }}"
{{- end }}
{{- if gt .MaxNumSeqs 0 }}
            - "--max-num-seqs"
            - "{{ .MaxNumSeqs }}"
{{- end }}
{{- end }}
{{- end }}
{{- if eq .AcceleratorType "cpu" }}
          # PRD-67: vLLM CPU needs SYS_NICE (get_mempolicy) + unconfined seccomp
          # (migrate_pages / numa_migrate_pages) for NUMA thread pinning.
          securityContext:
            seccompProfile:
              type: Unconfined
            capabilities:
              add:
                - SYS_NICE
{{- end }}
          resources:
            requests:
              cpu: {{ .CPURequest }}
              memory: {{ .MemoryRequest }}
{{- if eq .AcceleratorType "gpu" }}
              nvidia.com/gpu: "{{ .AcceleratorCount }}"
            limits:
              nvidia.com/gpu: "{{ .AcceleratorCount }}"
          volumeMounts:
            - name: shm
              mountPath: /dev/shm
{{- else if eq .AcceleratorType "cpu" }}
            {{- /* CPU: request/limit cpu + memory only — NO device resource
                   (no nvidia.com/gpu, no aws.amazon.com/neuron). shm volume for
                   the tensor-parallel / streamer staging buffer. */}}
            limits:
              cpu: {{ .CPURequest }}
              memory: {{ .MemoryRequest }}
          volumeMounts:
            - name: shm
              mountPath: /dev/shm
{{- else }}
              {{- /* Neuron: accelerator_count is NeuronCores, but K8s resource is devices (cores/2) */}}
              aws.amazon.com/neuron: "{{ div .AcceleratorCount 2 }}"
            limits:
              aws.amazon.com/neuron: "{{ div .AcceleratorCount 2 }}"
{{- end }}
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 60
          startupProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
{{- if eq .AcceleratorType "neuron" }}
            {{- /* Neuron compilation can take 30-60+ minutes; allow up to 90 minutes */}}
            failureThreshold: 540
{{- else }}
            {{- /* gpu + cpu: startup is weight-load dominated, no long compile wait */}}
            failureThreshold: 120
{{- end }}
          livenessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
{{- if or (eq .AcceleratorType "gpu") (eq .AcceleratorType "cpu") }}
      volumes:
        - name: shm
          emptyDir:
            medium: Memory
            sizeLimit: 16Gi
{{- end }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .Name }}
    app.kubernetes.io/component: model-server
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8000
      targetPort: http
      protocol: TCP
  selector:
    app.kubernetes.io/name: {{ .Name }}
